+def runcontrol_port(rc_address, rc_args):
+    # The explicit launcher option is appended last and therefore wins.
+    value = None
+    words = shlex.split(rc_args)
+    for index, word in enumerate(words):
+        if word == '--address' and index + 1 < len(words): value = words[index + 1]
+        elif word.startswith('--address='): value = word.split('=', 1)[1]
+    value = rc_address or value or '44000'
+    if value.startswith('tcp://'): value = value[6:]
+    try: port = int(value)
+    except ValueError: raise ValueError('RunControl address must be a TCP port')
+    if not 1 <= port <= 65535: raise ValueError('invalid RunControl TCP port')
+    return port
+
+def listening_inodes(port):
+    inodes = set()
+    for table in ('/proc/net/tcp', '/proc/net/tcp6'):
+        try:
+            with open(table, encoding='ascii') as stream:
+                next(stream, None)
+                for row in stream:
+                    fields = row.split()
+                    if int(fields[1].rsplit(':', 1)[1], 16) == port and fields[3] == '0A':
+                        inodes.add(fields[9])
+        except FileNotFoundError: continue
+    return inodes
+
+def wait_for_runcontrol(server, port):
+    # A real TCP connect would itself register a spurious EUDAQ participant.
+    pane = server.cmd('display-message', '-p', '-t', 'ITS3:rc', '#{pane_pid}')
+    if not pane.stdout: raise RuntimeError('cannot identify RunControl pane process')
+    root_pid = int(pane.stdout[0]); deadline = time.monotonic() + 30; seen = False
+    while time.monotonic() < deadline:
+        processes = [root_pid]; index = 0; rc_pids = []
+        while index < len(processes):
+            pid = processes[index]; index += 1
+            try:
+                with open(f'/proc/{pid}/cmdline', 'rb') as stream: args = stream.read().split(b'\0')
+                if any(arg.endswith(b'/ITS3RunControl.py') for arg in args): rc_pids.append(pid)
+                with open(f'/proc/{pid}/task/{pid}/children', encoding='ascii') as stream:
+                    processes.extend(int(child) for child in stream.read().split())
+            except (FileNotFoundError, ProcessLookupError): continue
+        inodes = listening_inodes(port)
+        for pid in rc_pids:
+            try:
+                for fd in os.listdir(f'/proc/{pid}/fd'):
+                    try: target = os.readlink(f'/proc/{pid}/fd/{fd}')
+                    except (FileNotFoundError, ProcessLookupError): continue
+                    if target.startswith('socket:[') and target[8:-1] in inodes: return
+            except (FileNotFoundError, ProcessLookupError): continue
+        if seen and not rc_pids: raise RuntimeError('RunControl exited before its listener was ready')
+        seen = seen or bool(rc_pids)
+        time.sleep(.05)
+    raise RuntimeError(f'RunControl did not open TCP port {port} before the deadline')
+
